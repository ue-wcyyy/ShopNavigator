# Copy this file to .env and fill in real values locally.
# .env is git-ignored; this template is the only credential-shaped file we commit.
# NEVER commit a real API key, token or private endpoint.

# --- LLM provider (TODO: confirm provider/model in docs/api-cost-budget.md) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=

# --- Agent / simulator limits (must match configs/default.yaml) ---
SHOPNAV_SEED=42
SHOPNAV_MAX_STEPS=30
SHOPNAV_TIMEOUT_SECONDS=300
SHOPNAV_MAX_USD_PER_TASK=0.05
SHOPNAV_MAX_USD_PER_RUN=2.00
